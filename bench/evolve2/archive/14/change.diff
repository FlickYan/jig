+/**
+ * Runs the last test command the model itself ran, once more, when a reply changed files but didn't run
+ * the tests after the change. The output goes with the changed file's result, so the model's next step
+ * sees whether the change holds and can fix it; on small tasks that step would otherwise be a final
+ * answer the tests never checked. The command already ran once in this conversation, so it is run again
+ * as it is — sandbox, working directory and all — and only ever here, before the step limit.
+ */
+async function retestChange(calls: ToolUse[], results: ToolResult[], command: string | undefined, conversation: Conversation, opts: AgentOptions, signal?: AbortSignal): Promise<void> {
+  const bash = opts.tools.find((tool) => tool.definition.name === "bash");
+  if (!bash || !command) return;
+  const kind = (name: string) => opts.tools.find((tool) => tool.definition.name === name)?.kind;
+  const changed = calls.map((call, i) => (kind(call.name) === "edit" && !results[i].is_error ? i : -1)).filter((i) => i >= 0).at(-1);
+  if (changed === undefined) return;
+  // The model ran the tests after this change itself, so they are already in front of it.
+  if (calls.some((call, i) => i > changed && call.name === "bash" && !results[i].is_error && TEST_COMMAND.test(String((call.input as ToolInput).command ?? "")))) return;
+  opts.ui.notice(`Running the tests again after the change.`);
+  let output: string;
+  try {
+    output = truncate(await bash.run({ command }, { cwd: opts.cwd, dirs: opts.dirs, versions: conversation.versions, signal, sandbox: opts.sandbox }));
+  } catch (err) {
+    output = `could not start: ${err instanceof Error ? err.message : String(err)}`;
+  }
+  const result = results[changed];
+  results[changed] = { ...result, content: `${String(result.content)}\n\nThe tests, run again after this change:\n$ ${command}\n${output}` };
+}
