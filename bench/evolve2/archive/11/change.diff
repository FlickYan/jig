+/** A line that imports or includes another module, in the languages jig's tasks tend to use. */
+const IMPORTISH = /\b(?:import|from|require|include|use)\b/;
+const WORD = /[A-Za-z_][A-Za-z0-9_]*/g;
+/** A file that stands in for the directory that names it: importing a package reads its entry point. */
+const PACKAGE_ENTRY = new Set(["__init__", "index", "mod"]);
+
+/**
+ * The project files whose name a file names in its imports: for `from table import render`, `table.py`.
+ * Matching names rather than parsing each language keeps it small and covers the same ground: the file
+ * the task points at says which modules to read, and the model doesn't have to enumerate to find them.
+ */
+async function importedFiles(text: string, self: string, cwd: string, dirs: string[]): Promise<string[]> {
+  const named = new Set<string>();
+  for (const line of text.split("\n")) {
+    if (line.length > 400 || !IMPORTISH.test(line)) continue;
+    for (const word of line.match(WORD) ?? []) if (word.length > 2) named.add(word.toLowerCase());
+  }
+  if (named.size === 0) return [];
+  const myself = resolve(cwd, self);
+  const found: string[] = [];
+  for (const file of await listFiles(cwd, ".", dirs).catch(() => [])) {
+    if (resolve(cwd, file) === myself) continue;
+    const name = basename(file).replace(/\.[^.]+$/, "").toLowerCase();
+    // A name matches its own file (`from table import render`), and a named directory its entry point
+    // (`from pkg import render` with pkg/__init__.py or pkg/index.js).
+    if (named.has(name) || (PACKAGE_ENTRY.has(name) && named.has(basename(dirname(file)).toLowerCase()))) found.push(file);
+  }
+  return found.slice(0, MAX_IMPORTS);
+}