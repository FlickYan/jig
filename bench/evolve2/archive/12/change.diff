diff --git a/src/tools/tests.ts b/src/tools/tests.ts
new file mode 100644
index 0000000..6becf9b
--- /dev/null
+++ b/src/tools/tests.ts
@@ -0,0 +1,41 @@
+// The project's tests, so the loop can run them right after a file change: the model learns whether the
+// change works in the same step, and the steps left go to repairing it instead of finding out. A command is
+// only proposed when the project's layout says how to run tests, and a missing runner falls back to a
+// standard-library one, so the check still runs.
+
+import { existsSync, readFileSync } from "node:fs";
+import { join } from "node:path";
+import { listFiles } from "./files.ts";
+
+/** Python test files by name: test_x.py and x_test.py. */
+const PYTHON_TEST = /(^|\/)(test[^/]*|[^/]*_test)\.py$/;
+
+/** A command that runs this project's tests, or null if its layout doesn't say how. */
+export async function testCommand(cwd: string, dirs: string[] = []): Promise<string | null> {
+  let files: string[];
+  try {
+    files = await listFiles(cwd, ".", dirs);
+  } catch {
+    return null;
+  }
+  if (files.some((file) => PYTHON_TEST.test(file))) return PYTHON_TESTS;
+  const packageJson = join(cwd, "package.json");
+  if (existsSync(packageJson) && hasScript(packageJson, "test")) return "npm test --silent";
+  return null;
+}
+
+/**
+ * pytest runs unittest's tests too and is the common choice; where it isn't installed, unittest is always
+ * there. discover's pattern finds both test_x.py and x_test.py.
+ */
+const PYTHON_TESTS = 'if python -c "import pytest" >/dev/null 2>&1; then python -m pytest -q; else python -m unittest discover -q -p "*test*.py"; fi';
+
+/** Whether package.json declares a non-empty script of that name. */
+function hasScript(file: string, name: string): boolean {
+  try {
+    const { scripts } = JSON.parse(readFileSync(file, "utf8")) as { scripts?: Record<string, unknown> };
+    return typeof scripts?.[name] === "string" && scripts[name] !== "";
+  } catch {
+    return false;
+  }
+}