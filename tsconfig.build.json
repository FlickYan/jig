{
  // The npm package: Node won't strip types from files under node_modules, so installed copies of jig
  // run JavaScript compiled from src/ into dist/. From a clone, Node runs src/ directly.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"]
}
