                 '''
             )
         )
+
+    def test_unclosed_endtag_with_name(self):
+        """Ensure an unclosed end tag with a name does not drop following content."""
+
+        self.assertMarkdownRenders(
+            self.dedent(
+                '''
+                Discard errors with `cmd 2</dev/null` and keep going.
+
+                This second paragraph must survive.
+                '''
+            ),
+            self.dedent(
+                '''
+                <p>Discard errors with <code>cmd 2&lt;/dev/null</code> and keep going.</p>
+                <p>This second paragraph must survive.</p>
+                '''
+            )
+        )
+
+    def test_unclosed_endtag_in_code_span(self):
+        """Ensure unclosed end tags in code spans are rendered as text."""
+
+        self.assertMarkdownRenders(
+            self.dedent(
+                '''
+                Shell redirections like `2</dev/null` and `cat </etc/hosts` must work.
+                '''
+            ),
+            self.dedent(
+                '''
+                <p>Shell redirections like <code>2&lt;/dev/null</code> and <code>cat &lt;/etc/hosts</code> must work.</p>
+                '''  # noqa: E501
+            )
+        )
