diff --git a/markdown/htmlparser.py b/markdown/htmlparser.py
index 488da03..4bd3ad2 100644
--- a/markdown/htmlparser.py
+++ b/markdown/htmlparser.py
@@ -102,7 +102,16 @@ class _HTMLParser(htmlparser.HTMLParser):
         if len(start) < 3 or not (65 <= c <= 90 or 97 <= c <= 122):
             self.handle_data(self.rawdata[i:i + 2])
             return i + 2
-        return super().parse_endtag(i)
+        end = super().parse_endtag(i)
+        if end < 0:
+            # The end tag is unterminated (or otherwise unparseable). Treat the
+            # opening `</` as data. We are always feeding a complete block, so
+            # waiting for more data is unnecessary. On Python 3.13.6 and later,
+            # returning `-1` here causes ``goahead`` to discard all remaining
+            # data at the end of the document instead of emitting it as text.
+            self.handle_data(self.rawdata[i:i + 2])
+            return i + 2
+        return end
 
     def parse_starttag(self, i: int) -> int:  # pragma: no cover
         # Treat `</>` as normal data as it is not a real tag.
