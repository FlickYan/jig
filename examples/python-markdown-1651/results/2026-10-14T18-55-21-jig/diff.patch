@@ -1787,3 +1787,41 @@ class TestHTMLBlocks(TestCase):
                 '''
             )
         )
+
+    def test_unclosed_endtag_with_name(self):
+        """An unclosed end tag which starts with a letter must not discard the rest of the document."""
+
+        self.assertMarkdownRenders(
+            self.dedent(
+                '''
+                Discard errors with `cmd 2</dev/null` and keep going.
+
+                This second paragraph must survive.
+                '''
+            ),
+            self.dedent(
+                '''
+                <p>Discard errors with <code>cmd 2&lt;/dev/null</code> and keep going.</p>
+                <p>This second paragraph must survive.</p>
+                '''
+            )
+        )
+
+    def test_shell_redirection(self):
+        """Shell redirections which contain unclosed end tags must render in code spans."""
+
+        self.assertMarkdownRenders(
+            self.dedent(
+                '''
+                Use `cat </etc/hosts` and `cmd 2</dev/null` to redirect.
+
+                A second paragraph.
+                '''
+            ),
+            self.dedent(
+                '''
+                <p>Use <code>cat &lt;/etc/hosts</code> and <code>cmd 2&lt;/dev/null</code> to redirect.</p>
+                <p>A second paragraph.</p>
+                '''
+            )
+        )
