diff --git a/markdown/htmlparser.py b/markdown/htmlparser.py
index 488da03..d6a27d3 100644
--- a/markdown/htmlparser.py
+++ b/markdown/htmlparser.py
@@ -102,7 +102,15 @@ class _HTMLParser(htmlparser.HTMLParser):
         if len(start) < 3 or not (65 <= c <= 90 or 97 <= c <= 122):
             self.handle_data(self.rawdata[i:i + 2])
             return i + 2
-        return super().parse_endtag(i)
+        endpos = super().parse_endtag(i)
+        if endpos == -1:
+            # The end tag is not properly closed (e.g. `</dev/null` with no `>`).
+            # Treat it as data so the rest of the document is not silently
+            # discarded by `goahead`, which drops everything remaining when an
+            # incomplete tag is encountered at the end of the data.
+            self.handle_data(self.rawdata[i:i + 2])
+            return i + 2
+        return endpos
 
     def parse_starttag(self, i: int) -> int:  # pragma: no cover
         # Treat `</>` as normal data as it is not a real tag.
