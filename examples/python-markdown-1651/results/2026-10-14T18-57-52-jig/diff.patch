+    def test_unclosed_endtag_with_name(self):
+        """Ensure an unclosed end tag with a tag name does not discard the following text."""
+
+        self.assertMarkdownRenders(
+            'Discard errors with `cmd 2</dev/null` and keep going.\n\n'
+            'This second paragraph must survive.',
+            '<p>Discard errors with <code>cmd 2&lt;/dev/null</code> and keep going.</p>\n'
+            '<p>This second paragraph must survive.</p>'
+        )
+        # A closing `>` elsewhere in the document must not cause the text to be discarded either.
+        self.assertMarkdownRenders(
+            'Use `cat </etc/hosts` and `echo hi > out`.',
+            '<p>Use <code>cat &lt;/etc/hosts</code> and <code>echo hi &gt; out</code>.</p>'
+        )
+        self.assertMarkdownRenders(
+            'A </unclosed tag.',
+            '<p>A &lt;/unclosed tag.</p>'
+        )
+
     def test_unclosed_endtag(self):
         """Ensure unclosed end tag does not have side effects."""
 
