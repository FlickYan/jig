diff --git a/markdown/htmlparser.py b/markdown/htmlparser.py
index 488da03..9715934 100644
--- a/markdown/htmlparser.py
+++ b/markdown/htmlparser.py
@@ -102,7 +102,15 @@ class _HTMLParser(htmlparser.HTMLParser):
         if len(start) < 3 or not (65 <= c <= 90 or 97 <= c <= 122):
             self.handle_data(self.rawdata[i:i + 2])
             return i + 2
-        return super().parse_endtag(i)
+        # The base parser returns a negative value when it cannot parse a complete end tag (for
+        # example `</dev/null`, which has no closing `>`). It then silently discards the
+        # remainder of the stream. As we always feed the entire document at once, such an end
+        # tag is not valid, so treat the `</` as data and keep the text which follows.
+        result = super().parse_endtag(i)
+        if result < 0:
+            self.handle_data(self.rawdata[i:i + 2])
+            return i + 2
+        return result
 
     def parse_starttag(self, i: int) -> int:  # pragma: no cover
