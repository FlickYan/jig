{
  "host": "0.0.0.0",
  "port": 8080,
  "database": "/var/lib/jig/jig.db",
  "dataDir": "/var/lib/jig",
  "concurrency": 8,
  "model": "deepseek-flash",
  "gatewayBaseUrl": "http://gateway:8081/anthropic",
  "runner": "docker",
  "docker": { "image": "jig-worker", "network": "jig-tasks", "cpus": 1, "memory": "2g", "pidsLimit": 512 },
  "tenants": [
    { "id": "example", "keys": ["<sha256 of the tenant's API key, in hex>"], "concurrency": 2, "timeLimit": 1800, "budgetUsd": 5 }
  ]
}
